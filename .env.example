# Noesis environment template
# Copy this file to `.env` for local backend development and to
# `services/frontend/.env` for frontend-only Vite variables as needed.
# Do not commit real secrets.

# ---------------------------------------------------------------------------
# Backend: Supabase
# ---------------------------------------------------------------------------
# Supabase project URL from Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key from Project Settings > API. Safe for frontend, but keep real
# project values out of public portfolio forks.
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role key from Project Settings > API. Backend only. Never expose this
# in Vite/frontend variables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional Supabase CLI/platform access token for local maintenance scripts.
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# ---------------------------------------------------------------------------
# Backend: AI providers
# ---------------------------------------------------------------------------
# OpenAI API key for GPT and embedding calls.
OPENAI_API_KEY=your_openai_api_key
# Optional OpenAI organization ID if your account requires it.
OPENAI_ORGANIZATION_ID=your_openai_org_id
# Keep true unless you intentionally test another policy.
OPENAI_ZERO_DATA_RETENTION=true
# Optional Cohere API key for reranking experiments.
COHERE_API_KEY=your_cohere_api_key

# ---------------------------------------------------------------------------
# Backend: infrastructure
# ---------------------------------------------------------------------------
# Local Docker Compose default.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Local GROBID server. Docker Compose exposes this internally as
# http://grobid:8070 and locally as http://localhost:8070.
GROBID_URL=http://localhost:8070
# Optional direct database URL for one-off maintenance scripts. Application code
# uses Supabase client APIs rather than SQLAlchemy app flows.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Backend: Stripe
# ---------------------------------------------------------------------------
# Stripe keys for the unfinished checkout/subscription flow.
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_ID_PRO=price_your_pro_price_id
STRIPE_PRICE_ID_TEAM=price_your_team_price_id

# ---------------------------------------------------------------------------
# Backend: app settings
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.bib
RATE_LIMIT_PER_MINUTE=100
SENTRY_DSN=your_sentry_dsn
UNPAYWALL_EMAIL=you@example.com
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key
FIGMA_PAT=your_figma_personal_access_token

# ---------------------------------------------------------------------------
# Frontend: Vite variables
# ---------------------------------------------------------------------------
# Put these in `services/frontend/.env` when running the frontend locally.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
