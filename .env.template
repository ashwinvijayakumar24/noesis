# ================================
# Noesis Environment Variables Template
# ================================
# This file documents all environment variables needed for production deployment
# Copy the relevant sections to your deployment platform's environment configuration

# ================================
# BACKEND ENVIRONMENT VARIABLES
# ================================
# Location: services/backend/.env

## Supabase (Authentication Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

## OpenAI
OPENAI_API_KEY=sk-proj-your-openai-api-key

## Database (PostgreSQL with pgvector extension)
# Development: postgresql+asyncpg://noesis:noesis_password@db:5432/noesis_dev
# Production: Get from your PostgreSQL provider (Render, Supabase, AWS RDS, etc.)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

## Redis Cache
# Development: redis://redis:6379
# Production: Get from your Redis provider (Upstash, Redis Cloud, AWS ElastiCache, etc.)
REDIS_URL=redis://host:6379

## GROBID (PDF Processing Service)
# Development: http://grobid:8070
# Production: Host your own or use a hosted GROBID service
GROBID_URL=http://your-grobid-service:8070

## Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://yourapp.com,https://www.yourapp.com

## File Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf

## Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# ================================
# FRONTEND ENVIRONMENT VARIABLES
# ================================
# Location: services/frontend/.env

## Backend API
# Development: http://localhost:8000
# Production: Your deployed backend URL
VITE_API_URL=https://api.yourapp.com

## Supabase (Public Keys - Safe for Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

## Optional Analytics (Uncomment if needed)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://your-sentry-dsn

# ================================
# DEPLOYMENT NOTES
# ================================
#
# 1. PostgreSQL Requirements:
#    - Must have pgvector extension installed
#    - Recommended providers: Supabase, Render, AWS RDS with pgvector
#
# 2. Redis Requirements:
#    - Standard Redis instance for caching
#    - Recommended providers: Upstash (free tier), Redis Cloud, AWS ElastiCache
#
# 3. GROBID:
#    - Can be self-hosted as Docker container
#    - Resource intensive - consider dedicated instance in production
#
# 4. Security:
#    - NEVER commit .env files to version control
#    - Use your deployment platform's secret management
#    - Rotate keys regularly
#    - Use different credentials for dev/staging/production
