# ================================
# Noesis Backend - Production Environment Variables
# ================================
# INSTRUCTIONS:
# 1. Copy this file to .env.production
# 2. Fill in all MANUAL values marked below
# 3. NEVER commit .env.production to git!

# ================================
# Database (PostgreSQL + pgvector)
# ================================
# MANUAL: Generate strong password
# Command: openssl rand -base64 32
DB_USER=noesis_prod
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# AUTOMATIC: Set by docker-compose.prod.yml - do not change
DATABASE_URL=postgresql+asyncpg://noesis_prod:CHANGE_ME_STRONG_PASSWORD_HERE@db:5432/noesis_prod

# ================================
# Redis Cache
# ================================
# AUTOMATIC: Set by docker-compose.prod.yml - do not change
REDIS_URL=redis://redis:6379

# ================================
# GROBID PDF Processing
# ================================
# AUTOMATIC: Set by docker-compose.prod.yml - do not change
GROBID_URL=http://grobid:8070

# ================================
# Supabase Authentication
# ================================
# MANUAL: Get from Supabase Dashboard
# URL: https://app.supabase.com/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ================================
# OpenAI API
# ================================
# MANUAL: Get from OpenAI Platform
# URL: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# ================================
# Application Settings
# ================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# MANUAL: Set to your Vercel frontend URL after deployment
# Example: https://noesis.vercel.app,https://www.yourapp.com
# Multiple origins: separate with commas
CORS_ORIGINS=https://your-vercel-app.vercel.app

# ================================
# File Upload Configuration
# ================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf

# ================================
# API Rate Limiting
# ================================
# Lower than dev to prevent resource exhaustion on micro instance
RATE_LIMIT_PER_MINUTE=50

# ================================
# Performance Tuning (Optional)
# ================================
# Uncomment to override defaults if needed
# UVICORN_WORKERS=1
# UVICORN_LIMIT_CONCURRENCY=50
# POSTGRES_MAX_CONNECTIONS=20
