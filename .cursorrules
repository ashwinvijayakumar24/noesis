## Code Patterns

### Database (Supabase only — no SQLAlchemy, no local PostgreSQL)
```python
# ✅ CORRECT
result = supabase.table("documents").select("*").eq("user_id", user_id).execute()
data = result.data

# ❌ WRONG
# session.query(Document).filter(Document.user_id == user_id).all()
```

### OpenAI (GPT-5.2 — use max_completion_tokens)
```python
# ✅ CORRECT
response = client.chat.completions.create(
    model="gpt-5.2",
    max_completion_tokens=2000,
    response_format={"type": "json_object"},
    messages=[...]
)

# ❌ WRONG
# model="gpt-4o", max_tokens=2000
```

### FastAPI patterns
```python
@router.post("/endpoint")
async def my_endpoint(
    request: MyRequest,
    current_user: dict = Depends(get_current_user)
):
    try:
        result = await my_service(request, current_user["id"])
        return {"success": True, "data": result}
    except Exception as e:
        logger.error(f"Error: {e}")
        raise HTTPException(status_code=500, detail=str(e))
```

### Frontend API calls
```typescript
// Use relative paths (Vite proxy to localhost:8000)
const response = await fetch(`/api/projects/${projectId}/documents`, {
  headers: {
    'Authorization': `Bearer ${session.access_token}`,
    'Content-Type': 'application/json'
  }
})
const data = await response.json()
```

### TypeScript component structure
```tsx
import { useState, useEffect } from 'react'
import { motion } from 'framer-motion'
import { SomeIcon } from '@heroicons/react/24/outline'

interface Props {
  projectId: string
  onClose: () => void
}

export default function MyComponent({ projectId, onClose }: Props) {
  const [loading, setLoading] = useState(false)

  return (
    <div className="bg-bg-surface border border-border-default rounded-lg p-6">
      {/* Use design system tokens — see DESIGN_SYSTEM.md */}
    </div>
  )
}
```

